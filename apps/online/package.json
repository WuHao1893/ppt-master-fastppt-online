{
  "name": "fastppt-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && vite build --config web/vite.config.ts",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "npm run smoke",
    "test:pptmaster": "tsx scripts/pptmaster-smoke.ts",
    "test:powerpoint": "tsx scripts/powerpoint-smoke.ts",
    "smoke": "tsx scripts/smoke.ts",
    "format:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.4.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
